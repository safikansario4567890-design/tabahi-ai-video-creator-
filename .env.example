# Server-side provider choice; Wan is open-source-first and never falls back to Replicate.
VIDEO_PROVIDER=wan
# Set this to a running Wan-compatible async API; this project does not bundle a GPU worker.
WAN_VIDEO_API_URL=
WAN_VIDEO_API_TOKEN=
WAN_VIDEO_MODEL=Wan2.1
VIDEO_PROVIDER_MAX_DURATION=5
VIDEO_API_KEY=
VIDEO_MODEL=kwaivgi/kling-v2.1-master
FREE_VIDEO_LIMIT=5
FREE_VIDEO_MAX_DURATION=50
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
TABHI_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long
